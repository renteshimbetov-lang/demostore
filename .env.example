# Telegram Bot Configuration
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Admin Telegram IDs (vergul bilan ajratilgan, masalan: 12345678,87654321)
ADMIN_IDS=123456789

# Ma'lumotlar bazasi (Neon PostgreSQL yoki SQLite)
# Neon PostgreSQL havolasi (Tavsiya etiladi):
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
# SQLite mahalliy fayli (DATABASE_URL bo'lmaganda ishlatiladi):
DATABASE_PATH=demostore.db

# Do'kon ma'lumotlari
STORE_NAME=Demo Store
SUPPORT_PHONE=+998901234567
SUPPORT_USERNAME=@demostore_support

# Valyuta kursi (Markaziy Bank API)
