# Telegram Bot Configuration
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Admin Telegram IDs (vergul bilan ajratilgan, masalan: 12345678,87654321)
ADMIN_IDS=123456789

# Telegram Kanal ma'lumotlari (Postlar tahlil qilinadigan kanal)
CHANNEL_ID=-1001234567890
CHANNEL_USERNAME=your_channel_username
CHANNEL_URL=https://t.me/your_channel_username

# WebApp URL (Mini App manzili)
WEBAPP_URL=https://your-domain.onrender.com

# Ma'lumotlar bazasi (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_PATH=demostore.db

# Do'kon ma'lumotlari
STORE_NAME=Demo Store
SUPPORT_PHONE=+998901234567
SUPPORT_USERNAME=@demostore_support

# Valyuta kursi (Markaziy Bank API)
CBU_API_URL=https://cbu.uz/oz/arkhiv-kursov-valyut/json/USD/
USD_RATE=12800

# Redis Kesh (ixtiyoriy, rasm va sessiyalarni doimiy saqlash uchun)
# REDIS_URL=redis://default:password@your-redis-host:6379
